{
	"schemaVersion": 1,
	"id": "renewable_lava",
	"version": "${version}",
	"name": "Renewable Lava",
	"description": "Adds vanilla-style renewable lava source generation, allowing lava to form renewable 2x2 source pools like water.",
	"authors": [
		"Dangeroni Labs"
	],
	"contact": {
		"homepage": "https://github.com/Dangeroni-Labs/renewable-lava",
		"sources": "https://github.com/Dangeroni-Labs/renewable-lava",
		"issues": "https://github.com/Dangeroni-Labs/renewable-lava/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/renewable_lava/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.dangeroni.renewablelava.RenewableLava"
		],
		"modmenu": [
			"dev.dangeroni.renewablelava.client.RenewableLavaModMenu"
		]
	},
	"mixins": [
		"renewable-lava.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
